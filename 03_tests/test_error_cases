-- =====================================================================
-- test_error_cases.sql
-- Every test below is MEANT to fail. Each block catches the error and
-- prints it, so you can see the exception handling working.
-- A line starting with "UNEXPECTED" would mean the error was NOT raised.
-- Run with F5 AFTER the schema, sample data, procedures and functions.
-- =====================================================================
SET SERVEROUTPUT ON SIZE UNLIMITED

PROMPT
PROMPT ===== TEST E1: student does not exist  [screenshot: register_student_unknown_student_output.png]
PROMPT Expected: ORA-20001
DECLARE
  v_id NUMBER;
BEGIN
  register_student(9999, 101, v_id);
  DBMS_OUTPUT.PUT_LINE('UNEXPECTED: no error was raised');
EXCEPTION
  WHEN OTHERS THEN DBMS_OUTPUT.PUT_LINE('Caught -> ' || SQLERRM);
END;
/

